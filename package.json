{
  "name": "playfy",
  "private": true,
  "version": "25.10.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:runner:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-runner-host.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-runner-cs.ps1",
    "build:runner:host": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-runner-host.ps1",
    "build:runner:cs": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-runner-cs.ps1",
    "copy:runner:win": "powershell -NoProfile -Command \"Write-Host 'Native game host and session card are built directly into src-tauri/resources'\"",
    "build:runner:linux": "cd ./src-linux && cargo build --release && cd ..",
    "copy:runner:linux": "cp ./src-linux/target/release/src-linux ./src-tauri/resources/src-linux",
    "build:runner:darwin": "cd ./src-darwin && cargo build --release && cd ..",
    "copy:runner:darwin": "cp ./src-darwin/target/release/src-darwin ./src-tauri/resources/src-darwin",
    "sync:runner": "node scripts/sync-runner.mjs",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-http": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@vueuse/core": "^13.1.0",
    "@vueuse/integrations": "^13.9.0",
    "fuse.js": "^7.1.0",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.1.5",
    "tailwindcss": "^4.1.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^5.2.1",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@8.15.3+sha256.fc4a49bd609550a41e14d20efbce802a4b892aa4cac877322de2f0924f122991"
}
